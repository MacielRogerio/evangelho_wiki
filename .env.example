# Node.js 22.13+ (recomendado: 24). Copie este arquivo para .env.
PORT=5173
APP_ORIGIN=http://localhost:5173
# Seu e-mail real; confirme-o pelo link antes de administrar.
ADMIN_EMAIL=
DATA_DIR=.private
# local: não envia e-mails; use npm run mail:local no terminal.
MAIL_MODE=local
# Para envio real, configure MAIL_MODE=resend e um remetente de domínio verificado.
RESEND_API_KEY=
MAIL_FROM=
# Em produção, NODE_ENV=production exige APP_ORIGIN=https://..., admin e Resend.
